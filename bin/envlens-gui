#!/usr/bin/env bash
set -euo pipefail
ENVLENS_LAUNCHER="$(readlink -f -- "${BASH_SOURCE[0]}")"
ENVLENS_ROOT="$(cd -- "$(dirname -- "$ENVLENS_LAUNCHER")/.." && pwd)"
export PYTHONPATH="$ENVLENS_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -c 'from envlens.app import run; raise SystemExit(run())' "$@"
